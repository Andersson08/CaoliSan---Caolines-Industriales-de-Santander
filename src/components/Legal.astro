---
import Base from "../layouts/Base.astro";
import n from "../data/negocio.json";
const { titulo, descripcion, h1 } = Astro.props;
const anio = new Date().getFullYear();
---
<Base titulo={titulo} descripcion={descripcion}>
  <header class="nav solida" id="nav">
    <div class="contenedor nav-in">
      <a href="/" class="marca"><img src="/logo-caolisan.png" alt={`${n.nombre} - ${n.razon}`} width="158" height="48" /></a>
      <div class="nav-der">
        <button type="button" class="tema-btn" id="tema" aria-label="Cambiar tema">
          <svg class="icono luna" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <svg class="icono sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="btn btn-borde btn-sm" href="/">Volver al inicio</a>
      </div>
    </div>
  </header>

  <main class="legal contenedor">
    <p class="etq">Información legal</p>
    <h1>{h1}</h1>
    <p class="legal-fecha">Vigente desde el {n.vigenciaLegal}</p>
    <div class="legal-txt">
      <slot />
    </div>
  </main>

  <footer class="pie">
    <div class="contenedor pie-base legal-pie">
      <p>© {anio} {n.nombre} · {n.razon} · {n.titular} · NIT {n.nit}</p>
      <p><a href="/privacidad">Política de datos</a> · <a href="/terminos">Términos y condiciones</a></p>
    </div>
  </footer>
</Base>
